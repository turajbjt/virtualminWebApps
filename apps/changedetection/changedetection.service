[Unit]
Description=Changedetection.io Web Page Change Monitor for Virtualmin domain
After=network.target

[Service]
Type=simple
User=${USER}
WorkingDirectory=${APP_DIR}
Environment="BASE_URL=${URL}"
ExecStart=/usr/bin/${ENGINE} run --rm --name changedetection-${USER} -p 127.0.0.1:${PORT}:5000 -e BASE_URL=${URL} -v ${DATA_DIR}:/datastore:Z ghcr.io/dgtlmoon/changedetection.io:${VERSION}
ExecStop=/usr/bin/${ENGINE} stop changedetection-${USER}
Restart=always
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
