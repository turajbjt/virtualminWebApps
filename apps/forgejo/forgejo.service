[Unit]
Description=Forgejo Git Service for %%DOMAIN%%
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%%USER%%
Group=%%GROUP%%
WorkingDirectory=%%WORK_DIR%%
ExecStart=%%EXEC_START%%
Restart=always
RestartSec=5s
Environment=USER=%%USER%% HOME=%%HOME%% FORGEJO_WORK_DIR=%%WORK_DIR%%
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
